#!/bin/bash

## Description: Run spec tests (all or specific files)
## Usage: atlas [options] [spec-files...]
## Example: "ddev atlas" runs all specs
## Example: "ddev atlas specs/features/interaction.yaml" runs single spec
## Example: "ddev atlas specs/features/*.yaml" runs matching specs
## Example: "ddev atlas --sequential --stop-on-failure"

set -e

SEQUENTIAL=false
STOP_ON_FAILURE=false
MAX_JOBS=${MAX_JOBS:-$(nproc 2>/dev/null || echo 4)}
OPTIONS=""
SPEC_ARGS=()

INVALID_ARGS=()

for arg in "$@"; do
    case $arg in
        --sequential|-s)
            SEQUENTIAL=true
            ;;
        --stop-on-failure)
            STOP_ON_FAILURE=true
            SEQUENTIAL=true  # Stop-on-failure requires sequential
            ;;
        --jobs=*)
            MAX_JOBS="${arg#*=}"
            ;;
        -j*)
            MAX_JOBS="${arg#-j}"
            ;;
        --*)
            OPTIONS="$OPTIONS $arg"
            ;;
        *.yaml|*.yml)
            # Spec file argument - resolve to absolute path
            if [[ "$arg" = /* ]]; then
                SPEC_ARGS+=("$arg")
            else
                SPEC_ARGS+=("/var/www/html/$arg")
            fi
            ;;
        specs/*|/*specs/*)
            # Path-like argument that's not a .yaml/.yml file
            INVALID_ARGS+=("$arg")
            ;;
        *)
            OPTIONS="$OPTIONS $arg"
            ;;
    esac
done

# Fail if invalid path arguments were passed
if [ ${#INVALID_ARGS[@]} -gt 0 ]; then
    echo "Error: Invalid spec file path(s) - must be .yaml or .yml files:"
    for inv in "${INVALID_ARGS[@]}"; do
        echo "  $inv"
    done
    exit 1
fi

# If spec files were provided, use those; otherwise find all
if [ ${#SPEC_ARGS[@]} -gt 0 ]; then
    SPEC_FILES=""
    MISSING=()
    for spec in "${SPEC_ARGS[@]}"; do
        if [ -f "$spec" ]; then
            SPEC_FILES="$SPEC_FILES $spec"
        else
            MISSING+=("$spec")
        fi
    done

    if [ ${#MISSING[@]} -gt 0 ]; then
        echo "Error: Spec file(s) not found:"
        for m in "${MISSING[@]}"; do
            echo "  ${m#/var/www/html/}"
        done
        exit 1
    fi

    SPEC_FILES=$(echo "$SPEC_FILES" | tr ' ' '\n' | grep -v '^$' | sort)
else
    SPEC_FILES=$(find /var/www/html/specs -type f -name "*.yaml" | sort)
fi

if [ -z "$SPEC_FILES" ]; then
    echo "Error: No spec files found"
    exit 1
fi

TOTAL=$(echo "$SPEC_FILES" | wc -l)

# Sequential mode (or when stop-on-failure is needed)
if [ "$SEQUENTIAL" = true ]; then
    CURRENT=0
    FAILED=()

    for SPEC_FILE in $SPEC_FILES; do
        CURRENT=$((CURRENT + 1))
        RELATIVE=${SPEC_FILE#/var/www/html/}

        if /var/www/html/machines/middleware-test-runner-parallel/run.sh --spec="$SPEC_FILE" $OPTIONS >/dev/null 2>&1; then
            echo "[$CURRENT/$TOTAL] PASS $RELATIVE"
        else
            echo "[$CURRENT/$TOTAL] FAIL $RELATIVE"
            FAILED+=("$RELATIVE")

            if [ "$STOP_ON_FAILURE" = true ]; then
                echo ""
                echo "Stopped on failure: $RELATIVE"
                exit 1
            fi
        fi
    done
else
    # Parallel mode
    RESULTS_DIR=$(mktemp -d)
    trap "rm -rf $RESULTS_DIR" EXIT

    echo "Running $TOTAL specs with $MAX_JOBS parallel jobs..."

    # Run specs in parallel with job control
    RUNNING=0
    INDEX=0

    for SPEC_FILE in $SPEC_FILES; do
        INDEX=$((INDEX + 1))
        RELATIVE=${SPEC_FILE#/var/www/html/}

        # Launch job in background
        (
            if /var/www/html/machines/middleware-test-runner-parallel/run.sh --spec="$SPEC_FILE" $OPTIONS >/dev/null 2>&1; then
                echo "PASS" > "$RESULTS_DIR/$INDEX"
            else
                echo "FAIL:$RELATIVE" > "$RESULTS_DIR/$INDEX"
            fi
        ) &

        RUNNING=$((RUNNING + 1))

        # Throttle: wait if we hit max jobs
        if [ $RUNNING -ge $MAX_JOBS ]; then
            wait -n 2>/dev/null || wait
            RUNNING=$((RUNNING - 1))
        fi
    done

    # Wait for remaining jobs
    wait

    # Collect results
    PASSED=0
    FAILED=()

    for i in $(seq 1 $TOTAL); do
        if [ -f "$RESULTS_DIR/$i" ]; then
            RESULT=$(cat "$RESULTS_DIR/$i")
            if [ "$RESULT" = "PASS" ]; then
                PASSED=$((PASSED + 1))
            else
                FAILED+=("${RESULT#FAIL:}")
            fi
        fi
    done
fi

echo ""
if [ "$SEQUENTIAL" = true ]; then
    echo "Results: $((TOTAL - ${#FAILED[@]}))/$TOTAL passed"
else
    echo "Results: $PASSED/$TOTAL passed"
fi

if [ ${#FAILED[@]} -gt 0 ]; then
    echo ""
    echo "Failed:"
    for spec in "${FAILED[@]}"; do
        echo "  $spec"
    done
    echo ""
    echo -e "⚠️  Run individual specs with"
    echo -e "ddev exec machines/middleware-test-runner-parallel/run.sh --spec=<path>"
    echo ""
    exit 1
fi
